// Phase 1 schema — journal entries, AI artifacts (separate from raw text), reminders, push tokens.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// AUTH 도입 이전 X-Dev-Email로 생성된 placeholder User는 null — signup 전까지 로그인 불가.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries         JournalEntry[]
  aiArtifacts     AiArtifact[]
  reminderSpecs   ReminderSpec[]
  pushTokens      DevicePushToken[]
  refreshTokens   RefreshToken[]
}

/// docs/auth-token-strategy.md §5 — 평문 저장 금지, SHA-256 해시만 저장. 리프레시마다 회전.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model JournalEntry {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body             String
  /// Emotion tag IDs from versioned catalog (see src/types/journal.ts)
  emotionTagIds    String[]
  source           String   @default("app")
  /// 기록 저장 시점 날씨 스냅샷(선택, 앱에서 전달 시)
  weather          Json?
  deleted          Boolean  @default(false)
  clientMutationId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  aiArtifacts AiArtifact[]

  @@index([userId, createdAt(sort: Desc)])
}

/// AI outputs — never overwrite JournalEntry.body
model AiArtifact {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId        String?
  entry          JournalEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  kind           String
  model          String
  promptVersion  String
  payload        Json
  createdAt      DateTime @default(now())

  @@index([userId, kind, createdAt(sort: Desc)])
  @@index([entryId])
}

model ReminderSpec {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeZone  String
  schedule  Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
}

model DevicePushToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String // "ios" | "android"
  token      String
  lastSeenAt DateTime @default(now())

  @@unique([userId, token])
}
