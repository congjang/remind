# Copy to server/.env
DATABASE_URL="postgresql://remind:remind@localhost:5432/remind"
PORT=4000

# Future: BullMQ
# REDIS_URL="redis://localhost:6379"
# OPENAI_API_KEY=""

# ─── CORS (프로덕션 전용) ──────────────────────────────────────────────────────
# 배포 시 허용할 프론트엔드 도메인으로 설정 (기본값: 모든 오리진 차단)
# CORS_ORIGIN=https://your-domain.com
# ──────────────────────────────────────────────────────────────────────────────

# ─── JWT 인증 (필수 — 없으면 서버가 기동 시점에 즉시 종료됨) ───────────────────
# 반드시 서버 전용 .env에만 설정 — NEXT_PUBLIC_ 접두사 절대 금지(브라우저에 노출됨, CLAUDE.md §5-1)
# 최소 32바이트 이상의 무작위 값 사용 (예: openssl rand -base64 48)
JWT_SECRET=
# ─────────────────────────────────────────────────────────────────────────────
