# Copy to server/.env
DATABASE_URL="postgresql://remind:remind@localhost:5432/remind"
PORT=4000

# Future: BullMQ
# REDIS_URL="redis://localhost:6379"
# OPENAI_API_KEY=""

# ─── CORS (프로덕션 전용) ──────────────────────────────────────────────────────
# 배포 시 허용할 프론트엔드 도메인으로 설정 (기본값: 모든 오리진 차단)
# CORS_ORIGIN=https://your-domain.com
# ──────────────────────────────────────────────────────────────────────────────

# ─── 인증 경고 ───────────────────────────────────────────────────────────────
# X-Dev-Email 인증은 개발 전용입니다.
# NODE_ENV=production 에서는 이 값이 없으면 서버가 즉시 종료됩니다.
# 실제 JWT 인증으로 교체한 후에만 아래 주석을 해제하세요.
# ALLOW_DEV_AUTH=true
# ─────────────────────────────────────────────────────────────────────────────

# ─── JWT 인증 (AUTH 구현 후 사용, 현재 미사용) ─────────────────────────────────
# 반드시 서버 전용 .env에만 설정 — NEXT_PUBLIC_ 접두사 절대 금지(브라우저에 노출됨, CLAUDE.md §5-1)
# 최소 32바이트 이상의 무작위 값 사용 (예: openssl rand -base64 48)
# JWT_SECRET=
# ─────────────────────────────────────────────────────────────────────────────
