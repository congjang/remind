# Copy to .env.local (not committed). Restart `npm run dev` after changes.

# 디자인 토큰 동기화 (npm run tokens:figma:export) — Figma REST API 토큰
# 발급: Figma > Settings > Personal access tokens (file_variables:read 권한 필요)
# 주의: 이 값은 순수 Node 스크립트가 읽으므로 .env.local이 아닌 셸 환경변수로 넘겨야 함
#   예) FIGMA_TOKEN=xxx npm run tokens:figma:export  (docs/DESIGN_TOKENS_RUNBOOK.md 참고)
# FIGMA_TOKEN=

# Optional: sync 기록 저장 to remind-api (leave unset = localStorage only)
# NEXT_PUBLIC_REMIND_API_URL=http://127.0.0.1:4000
# NEXT_PUBLIC_DEV_EMAIL=you@example.com

# 기록하기 상단 날씨 (서버 전용 — 클라이언트에 노출되지 않음)
# OpenWeatherMap: https://openweathermap.org/api
# OPENWEATHERMAP_API_KEY=
